---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('blog');

  const paths = pages.map(page => {
    const [lang, ...rest] = page.slug.split('/');
    // If lang is "sr", don't include it in the URL
    if (lang === 'sr') {
      return { params: { slug: rest.join('/') || undefined }, props: page };
    } else {
      return { params: { lang, slug: rest.join('/') || undefined }, props: page };
    }
  });

  return paths;
}

const page = Astro.props;
---
<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>{page.data.title}</h1>
    <h2>{page.data.author}</h2>
    <h3>{page.data.date}</h3>
</body>
</html>